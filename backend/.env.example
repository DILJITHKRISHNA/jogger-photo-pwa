# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4010
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3010

# PostgreSQL. docker-compose maps the container's 5432 to host 5434 to
# avoid clashing with a locally-installed Postgres also listening on the
# default 5432 (and with car-wash-erp's own compose, which uses 5433).
DATABASE_URL="postgresql://jogger:jogger_password@localhost:5434/jogger_photo_pwa?schema=public"

# JWT — access token short-lived, refresh token longer-lived and rotated
# on every use. Generate strong secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Redis — light use today (dashboard-stats cache); same infra shape as the
# reference project so BullMQ/pub-sub can be added later without a rework.
# docker-compose maps this to host 6381 to avoid port clashes.
REDIS_URL=redis://localhost:6381

# Local disk is the default photo store (uploads/products/, served at
# /uploads/products/*). Set these to switch to S3-compatible storage —
# leave blank to keep using local disk.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Rate limiting (brute force / scraping protection).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# Seed script (prisma/seed.ts) — creates the first ADMIN login + a couple
# of EXECUTIVE logins, plus a small demo catalogue.
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_EXEC_PHONE=9000000001
SEED_EXEC_PASSWORD=ChangeMe123!
