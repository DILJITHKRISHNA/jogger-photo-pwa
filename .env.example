# ----------------------------------------------------------------------------
# Admin panel password (change this before going live)
# ----------------------------------------------------------------------------
ADMIN_PASSWORD=admin123

# ----------------------------------------------------------------------------
# Executive sign-in access code (shared code + name/employee ID — see README
# for how to swap this for real OTP/SSO later)
# ----------------------------------------------------------------------------
EXEC_ACCESS_CODE=jogger2026

# ----------------------------------------------------------------------------
# Supabase (optional — cloud photo storage). Leave unset to use local disk
# storage under public/uploads/products, which works out of the box.
# ----------------------------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Storage → New bucket → name it "product-photos" → make it Public
# 3. Project Settings → API → copy the values below
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=product-photos
